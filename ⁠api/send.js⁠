const https = require('https');

function sendTelegramRequest(token, method, payload, isJson = true) {
    return new Promise((resolve, reject) => {
        let bodyData = '';
        let headers = {};

        if (isJson) {
            bodyData = JSON.stringify(payload);
            headers = {
                'Content-Type': 'application/json',
                'Content-Length': Buffer.byteLength(bodyData)
            };
        } else {
            bodyData = payload.body;
            headers = payload.headers;
        }

        const req = https.request({
            hostname: 'api.telegram.org',
            path: `/bot${token}/${method}`,
            method: 'POST',
            headers: headers
        }, (res) => {
            let data = '';
            res.on('data', chunk => data += chunk);
            res.on('end', () => {
                try { resolve(JSON.parse(data)); }
                catch (e) { resolve({ ok: false, raw: data }); }
            });
        });

        req.on('error', (err) => reject(err));
        req.write(bodyData);
        req.end();
    });
}

function createMultipartFormData(fields, files) {
    const boundary = '----WebKitFormBoundary' + Math.random().toString(36).substring(2);
    const CRLF = '\r\n';
    let chunks = [];

    for (const [key, val] of Object.entries(fields)) {
        chunks.push(Buffer.from(
            `--${boundary}${CRLF}` +
            `Content-Disposition: form-data; name="${key}"${CRLF}${CRLF}` +
            `${val}${CRLF}`
        ));
    }

    files.forEach((file) => {
        chunks.push(Buffer.from(
            `--${boundary}${CRLF}` +
            `Content-Disposition: form-data; name="${file.name}"; filename="${file.filename}"${CRLF}` +
            `Content-Type: ${file.contentType}${CRLF}${CRLF}`
        ));
        chunks.push(file.buffer);
        chunks.push(Buffer.from(CRLF));
    });

    chunks.push(Buffer.from(`--${boundary}--${CRLF}`));

    const body = Buffer.concat(chunks);
    return {
        body,
        headers: {
            'Content-Type': `multipart/form-data; boundary=${boundary}`,
            'Content-Length': body.length
        }
    };
}

module.exports = async (req, res) => {
    const token = process.env.BOT_TOKEN || '8921957218:AAFCEqYBED26CTyp3vFxKpfU3m4dsFduBiI';

    if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });

    try {
        const { type, media, text, chat_id } = req.body;

        // 1. CHỈ GỬI TEXT
        if (type === 'text') {
            const data = await sendTelegramRequest(token, 'sendMessage', {
                chat_id,
                text,
                parse_mode: 'HTML'
            });
            return res.status(200).json(data);
        }

        // 2. GỬI 1 TẤM ẢNH
        if (type === 'photo' && media && media.length === 1) {
            const b64 = media[0].media.split(',')[1];
            const buf = Buffer.from(b64, 'base64');

            const fields = { chat_id };
            if (media[0].caption) fields.caption = media[0].caption;

            const files = [{
                name: 'photo',
                filename: 'photo.jpg',
                contentType: 'image/jpeg',
                buffer: buf
            }];

            const formData = createMultipartFormData(fields, files);
            const data = await sendTelegramRequest(token, 'sendPhoto', formData, false);
            return res.status(200).json(data);
        }

        // 3. GỬI NHIỀU ẢNH (CAMERA TRƯỚC + SAU)
        if (type === 'media' && Array.isArray(media) && media.length > 1) {
            const files = [];
            const telegramMedia = media.map((item, index) => {
                const fieldName = `file${index}`;
                const b64 = item.media.split(',')[1];
                const buf = Buffer.from(b64, 'base64');

                files.push({
                    name: fieldName,
                    filename: `image${index}.jpg`,
                    contentType: 'image/jpeg',
                    buffer: buf
                });

                return {
                    type: 'photo',
                    media: `attach://${fieldName}`,
                    caption: item.caption || ''
                };
            });

            const fields = {
                chat_id,
                media: JSON.stringify(telegramMedia)
            };

            const formData = createMultipartFormData(fields, files);
            const data = await sendTelegramRequest(token, 'sendMediaGroup', formData, false);
            return res.status(200).json(data);
        }

        return res.status(400).json({ error: "Invalid data format" });

    } catch (e) {
        return res.status(500).json({ error: e.message });
    }
};
